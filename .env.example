# Copy to .env for local development. Never commit real values.

# PostgreSQL connection string (local Postgres in dev, Neon in production)
DATABASE_URL=

# Long random string used to sign session tokens (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=

# Public URL of the site, no trailing slash (http://localhost:3000 in dev)
NEXT_PUBLIC_SERVER_URL=

# Vercel Blob token for photo storage. Leave empty in dev to store files in ./media
BLOB_READ_WRITE_TOKEN=

# Optional: remove.bg API key. When set, product photo backgrounds are removed on upload
REMOVE_BG_API_KEY=

# Only read by `pnpm create-admin` (creates a Payload Admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=
