{
  "name": "list-your-wishes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/avatar-manifest.mjs && NODE_OPTIONS=--no-deprecation next dev",
    "build": "node scripts/avatar-manifest.mjs && NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "node scripts/avatar-manifest.mjs && tsc --noEmit",
    "avatars": "node scripts/avatar-manifest.mjs",
    "seed": "NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "create-admin": "NODE_OPTIONS=--no-deprecation payload run scripts/create-admin.ts",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "format": "oxfmt",
    "test:api": "node scripts/smoke-test.mjs",
    "vercel-build": "NODE_OPTIONS=--no-deprecation payload migrate && pnpm build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.18.0"
}
